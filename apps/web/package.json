{
  "name": "@chikachow/booze-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "WRANGLER_WRITE_LOGS=false vite build && pnpm run bundle:check",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "deploy": "pnpm run build && WRANGLER_WRITE_LOGS=false wrangler deploy",
    "dev": "WRANGLER_WRITE_LOGS=false vite dev",
    "preview": "vite preview",
    "test": "node --test --enable-source-maps worker/*.test.ts scripts/*.test.mjs && vitest run && pnpm run theme:check && pnpm run test:browser",
    "test:browser": "playwright test",
    "theme:build": "astryx theme build src/booze-theme.ts --out src/generated/booze.css",
    "theme:check": "test -f src/generated/booze.css.d.ts && pnpm run theme:build --check",
    "typecheck": "tsc --noEmit",
    "wrangler:types": "WRANGLER_WRITE_LOGS=false wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.6",
    "@astryxdesign/theme-neutral": "0.7.6",
    "@chikachow/booze-db": "workspace:*",
    "@clerk/backend": "3.26.5",
    "@clerk/react": "6.18.4",
    "@fontsource-variable/figtree": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stylexjs/stylex": "0.19.1",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.6",
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  }
}
